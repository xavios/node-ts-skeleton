{
  "name": "ts-node-skeleton",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "author": "AndrasHacks <mr.acs.andras@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "nodemon",
    "debug": "node --inspect-brk --import tsx ./src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "execute": "rm -rf ./dist && yarn build && node ./dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:debug": "node --inspect-brk ./node_modules/vitest/vitest.mjs run --no-file-parallelism",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eject:danger": "node ./scripts/create-from-template.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "packageManager": "yarn@4.19.0"
}
